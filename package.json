{
  "name": "numo",
  "version": "8.1.0",
  "description": "Numo: ingresos, gastos, suscripciones y cuotas del mes, pensada para Argentina.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:artifact": "vite build --mode artifact && node scripts/build-artifact.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm test && playwright install chromium && npm run test:e2e"
  },
  "author": "Mateo Copello",
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
